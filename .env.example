OPSATLAS_DATABASE_URL=sqlite:///./opsatlas.db
OPSATLAS_INGESTION_MODE=inline
OPSATLAS_LLM_MODE=extractive
# Optional OpenAI-compatible local or hosted model:
# OPSATLAS_LLM_MODE=llm
# OPSATLAS_LLM_BASE_URL=http://127.0.0.1:8081/v1
# OPSATLAS_LLM_MODEL=your-model
# OPSATLAS_LLM_API_KEY=
# OPSATLAS_EMBEDDING_MODEL=your-embedding-model
# Set a deployment key before exposing the API outside localhost.
OPSATLAS_API_KEY=
